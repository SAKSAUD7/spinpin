{
  "model": "cms.pagesection",
  "pk": 2,
  "fields": {
    "page": "home",
    "section_key": "about",
    "title": "Leicester's Premier Entertainment Venue",
    "subtitle": "Three amazing activities under one roof",
    "content": "Spin Pin is Leicester's go-to destination for roller skating, ten pin bowling, and arcade games. Conveniently located on Navigation Street in Leicester City Centre, we offer fun for the whole family. With 8+ bowling lanes, a full roller skating rink, and over 100 arcade machines, there's always something exciting waiting for you. Walk-ins are welcome û just show up and start playing! \nWelcome to Spin Pin û The ultimate destination in Leicester for fun and excitement! Whether you're looking to glide across the roller rink, strike big in our ten pin bowling lanes, or challenge your friends to thrilling arcade games, we've got something for everyone.\n\nEnjoy a variety of attractions:\nò Arcade Games for all ages\nò Roller Skating parties and open roller rink sessions\nò Ten Pin Bowling\nò VR Arcade\n\nPerfect for roller skating parties, group outings, or a spontaneous day of adventure, Spin Pin offers an unforgettable experience filled with energy, music, and non-stop entertainment.",
    "image_url": null,
    "video_url": null,
    "cta_text": "View Activities",
    "cta_link": "/attractions",
    "order": 2,
    "active": true,
    "created_at": "2026-05-10T00:54:09.937Z",
