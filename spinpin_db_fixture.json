{
  "model": "cms.pagesection",
  "pk": 5,
  "fields": {
    "page": "about",
    "section_key": "story",
    "title": "Our Story",
    "subtitle": null,
    "content": "<p>Spin Pin Leicester was born from a simple idea: create a space where people of all ages can enjoy roller skating, bowling, and arcade games together û all under one roof, right in the heart of Leicester City Centre.</p><p>We opened our doors on Navigation Street and quickly became the city's favourite venue for family outings, birthday parties, date nights, school trips, and corporate events. We combine the nostalgia of roller skating with the thrill of ten pin bowling and the excitement of over 100 arcade machines.</p><p>Whether you're a seasoned bowler, an experienced skater, or a complete beginner, Spin Pin welcomes you. Our friendly staff are always on hand to help, and our facilities are designed with safety, comfort, and fun in mind.</p>",
    "image_url": "/images/uploads/img-3.jpg",
    "video_url": null,
    "cta_text": null,
    "cta_link": null,
    "order": 2,
    "active": true,
