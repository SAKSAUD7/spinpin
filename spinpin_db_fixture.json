{
  "model": "cms.bookinginformation",
  "pk": 1,
  "fields": {
    "booking_type": "SESSION",
    "title": "Spin Pin Session Booking",
    "subtitle": "Booking Available from Thursday's to Sunday's",
    "content": "Half Term - Peak School & Bank holidays.\n\nMonday - Closed\nTuesday to Sunday 12 pm to 10:00 pm",
    "rules_content": "SPIN PIN ROLLER SKATING VENUE û RULES & GUIDELINES\n\nWelcome to Spin Pin! To ensure that all our guests have a safe and enjoyable experience, we ask that you read and follow the following rules and guidelines.\n\n1. GENERAL RULES\nò Skating Area: Only roller skates, inline skates, or skateboards are permitted on the rink\nò Use of Skates: participants must not skate outside the rink or wear the skates to the toilets, cafΘ or to access any other areas\nò Adherence to Instructions: All skaters must follow the instructions provided by Spin Pin staff\nò Respect for Others: Always be considerate and respectful towards fellow skaters\nò Alcohol and Drugs: Strictly prohibited\nò Smoking: Not allowed inside the venue\n\n2. SAFETY GUIDELINES\nò Participation: you must not participate without signing the required waiver\nò Skating at Your Own Risk: Roller skating involves inherent risks of injury\nò Safety Gear: Encouraged for all skaters, especially beginners\nò Skate Within Your Ability: Skate at speeds appropriate for your skill level\n\n3. AGE RESTRICTIONS\nò Minimum Age: Skating is permitted for individuals aged 5 and up\nò Children under 16 must be accompanied by an adult (18 years or older)",
    "sessions_info": [
      {
        "name": "Rolly Polly",
        "description": "A general skate session Open to all ages and ability",
        "schedule": [
          "Thursday 3 pm to 8 pm",
          "Friday 3 pm to 8 pm",
          "Saturday and Sunday 12 pm to 8 pm"
        ]
      },
      {
        "name": "Teen Tribe",
        "description": "Skating session for teens aged 13 to 17 years old only of all skating abilities",
        "schedule": [
          "Thursday 8 pm to 9:30 pm"
        ]
      },
      {
        "name": "Grown-up Glide",
        "description": "Adult only skating session 18+ of all skating abilities",
        "schedule": [
          "Friday 8 pm to 9:30 pm"
        ]
      },
      {
        "name": "Grand Disco",
        "description": "For all ages and abilities",
        "schedule": [
          "Saturday 8 pm to 9:30 pm"
        ]
      }
    ],
    "active": true,
    "created_at": "2026-05-10T00:54:18.278Z",
